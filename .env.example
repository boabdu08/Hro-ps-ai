# Copy to `.env` for local dev.
# Demo note: HRO-PS uses realistic demo/synthetic operational data.
# No real patient data should be stored in this project for the graduation demo.

# ---- App ----
# Use APP_ENV=prod in cloud deployment.
APP_ENV=dev

# ---- API / Dashboard ----
API_BASE_URL=http://127.0.0.1:8000

# ---- CORS ----
# Comma-separated list of allowed dashboard/browser origins.
# Example:
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CORS_ORIGINS=

# ---- Database ----
# For Neon/Supabase/Render/Railway Postgres, use the provider connection string.
# Prefer sslmode=require for cloud Postgres when required by the provider.
# Example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Local example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/hro_db
DATABASE_URL=

# ---- JWT ----
# CHANGE IN PRODUCTION. Never use the demo value in public deployment.
JWT_SECRET_KEY=dev-unsafe-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Artifacts ----
# Keep as `.` when artifacts are stored in the repository root.
# Required demo artifacts include forecast outputs, metrics_72h, and legacy runtime model files.
ARTIFACT_DIR=.

# ---- Tenancy ----
TENANT_MODE_ENABLED=true
DEFAULT_TENANT_SLUG=demo-hospital

# ---- Scheduler / worker ----
# Keep scheduler out of the API process for normal deployment.
SCHEDULER_RUN_IN_API=false
SCHEDULER_INTERVAL_SECONDS=300
SYNTHETIC_DATA_ENABLED=true
SYNTHETIC_EMERGENCY_RATE=0.03

# ---- SQLAlchemy pool tuning ----
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=1800
