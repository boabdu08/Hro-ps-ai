__pycache__/
*.py[cod]
*$py.class

# virtualenvs
.venv/
.venv311/
.venv*/
venv/
env/
ENV/

# distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml

# Streamlit cache
.streamlit/cache/

# ML / artifacts — exclude large binary files by default
*.h5
*.keras
*.pkl
*.joblib
*.npz
*.npy

# Exception: required deployment artifacts must be versioned so cloud deployments work
# Without these exceptions, Render/Railway deployments will fail health checks.
!artifacts/models_72h/*.keras
!artifacts/models_72h/*.pkl
!artifacts/models_72h/*.json
!artifacts/forecast_outputs/*.csv
!artifacts/metrics_72h/*.csv
!artifacts/metrics_72h/*.json
!artifacts/manifests/*.json

# Local DB / cache
*.sqlite3

# Local Postgres data (if ever created)
*.db

# OS/editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# env/secrets
.env
.env.*
!.env.example

# python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
htmlcov/

# artifacts / outputs (keep if you intentionally version them)
*.log

# temp files
tmp_*.txt





